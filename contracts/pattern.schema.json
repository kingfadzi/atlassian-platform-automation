{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlassian-platform-automation:pattern:v1",
  "title": "Draft pattern intent; not an executable provider configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "kind", "profile", "parameters", "managed_properties", "desired_outcomes", "adapter", "live_verification"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "draft"},
    "kind": {"enum": ["foundation", "jira_project", "confluence_space"]},
    "profile": {"const": "FS-COLLAB-01"},
    "parameters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^P-(0[1-9]|1[0-9]|2[0-2])$"}},
    "managed_properties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "desired_outcomes": {"type": "object", "minProperties": 1},
    "adapter": {"type": "null"},
    "live_verification": {"const": "untested"}
  }
}
