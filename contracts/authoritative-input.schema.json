{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlassian-platform-automation:authoritative-input:v1",
  "title": "Source-record envelope; structural validity does not prove authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "record_type", "subject_ref", "source", "observed_at", "effective_at", "expires_at", "status", "synthetic", "data"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "record_type": {"enum": ["application", "ownership", "classification", "approval", "exception"]},
    "subject_ref": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["system", "reference", "version"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "reference": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["active", "approved", "withdrawn", "expired", "retired", "unknown"]},
    "synthetic": {"type": "boolean"},
    "data": {"type": "object"}
  }
}
