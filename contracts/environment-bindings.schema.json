{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlassian-platform-automation:environment-bindings:v1",
  "title": "Offline, unbound lab only",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "status", "mode", "remote_operations_authorized", "profile", "organization_id", "sites", "credential_refs", "runtime_store_refs", "authority_mode"],
  "properties": {
    "schema_version": {"const": 1},
    "environment": {"const": "lab"},
    "status": {"const": "unbound"},
    "mode": {"const": "offline_scaffold"},
    "remote_operations_authorized": {"const": false},
    "profile": {"const": "FS-COLLAB-01"},
    "organization_id": {"type": "null"},
    "sites": {
      "type": "object", "additionalProperties": false, "required": ["jira", "confluence"],
      "properties": {
        "jira": {"type": "object", "additionalProperties": false, "required": ["cloud_id", "base_url"], "properties": {"cloud_id": {"type": "null"}, "base_url": {"type": "null"}}},
        "confluence": {"type": "object", "additionalProperties": false, "required": ["cloud_id", "base_url"], "properties": {"cloud_id": {"type": "null"}, "base_url": {"type": "null"}}}
      }
    },
    "credential_refs": {
      "type": "object", "additionalProperties": false, "required": ["observer", "executor"],
      "properties": {"observer": {"type": "null"}, "executor": {"type": "null"}}
    },
    "runtime_store_refs": {
      "type": "object", "additionalProperties": false, "required": ["state", "evidence", "event_cursors"],
      "properties": {"state": {"type": "null"}, "evidence": {"type": "null"}, "event_cursors": {"type": "null"}}
    },
    "authority_mode": {"const": "synthetic_fixtures_only"}
  }
}
