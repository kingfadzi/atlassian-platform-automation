{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlassian-platform-automation:evidence-record:v1",
  "title": "Evidence manifest; not an evidence-retention implementation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "evidence_type", "synthetic", "environment", "target_ref", "control_ids", "register_revision", "profile", "implementation_revision", "observed_at", "result", "authority_refs", "observations", "retention_category"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "evidence_type": {"enum": ["schema_fixture", "policy_unit", "adapter_contract", "live_acceptance", "supplier_assurance"]},
    "synthetic": {"type": "boolean"},
    "environment": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "control_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z&]+-[0-9]{2}$"}},
    "register_revision": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"enum": ["assumed", "approved", "withdrawn"]}
      }
    },
    "implementation_revision": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["untested", "conformant_within_tested_scope", "approved_exception", "nonconformant", "unknown_stale"]},
    "authority_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observations": {"type": "array", "items": {"type": "object"}},
    "retention_category": {"enum": ["operational_log", "material_decision", "other"]}
  }
}
