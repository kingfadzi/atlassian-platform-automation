{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlassian-platform-automation:asset-intent:v1",
  "title": "Draft synthetic asset intent, not authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_key", "kind", "environment", "status", "synthetic", "business_application_ref", "requested_classification", "pattern", "audience_group_refs", "authority_refs", "managed_properties", "deletion_authorized"],
  "properties": {
    "schema_version": {"const": 1},
    "asset_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "kind": {"enum": ["jira_project", "confluence_space"]},
    "environment": {"const": "lab"},
    "status": {"const": "draft"},
    "synthetic": {"const": true},
    "business_application_ref": {"type": "string", "minLength": 1},
    "requested_classification": {"enum": ["Restricted", "Confidential", "Internal", "Public"]},
    "pattern": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "audience_group_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "authority_refs": {
      "type": "object", "additionalProperties": false, "required": ["application", "ownership", "classification", "approval"],
      "properties": {
        "application": {"type": "string", "minLength": 1},
        "ownership": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "approval": {"type": "string", "minLength": 1}
      }
    },
    "managed_properties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "deletion_authorized": {"const": false}
  }
}
